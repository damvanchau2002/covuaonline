# Server environment variables

# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/covua
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# JWT secret used by server auth
JWT_SECRET=replace-with-a-strong-secret

# Optional: server port (defaults to 4000)
# PORT=4000