# Example environment variables (do NOT put secrets here)

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth / Auth
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Tenor GIF API key (uses public demo if empty)
NEXT_PUBLIC_TENOR_KEY=

# Other service keys
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# Add any other config keys required by your app

# Server (Express) – MongoDB connection
# For local MongoDB: mongodb://localhost:27017/covua
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/covua